# Copy this file to .env.local and fill in what you need.

# Anthropic API key — powers "brief -> first draft" generation and
# per-scene revision. OPTIONAL: without it the app still runs with the
# bundled examples, full timeline editing, and MP4 rendering.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Override the generation model. Defaults to claude-sonnet-5.
# MOTION_LAB_MODEL=claude-sonnet-5
